# SentinelAI Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Flask secret key (auto-generated in production)
SECRET_KEY=change-this-to-a-random-string

# Database (leave empty to use SQLite locally)
# DATABASE_URL=postgresql://user:pass@host/dbname

# ── Gmail Notifications ──────────────────────────────────────────────────────
# Use a Gmail App Password (not your real password)
# Enable 2FA → Google Account → Security → App Passwords → Create
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated list of email recipients
ALERT_EMAILS=hotel-manager@example.com,security-head@example.com

# ── SMS via Twilio ────────────────────────────────────────────────────────────
# Get from twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Comma-separated list of phone numbers (international format)
ALERT_PHONES=+91xxxxxxxxxx,+91xxxxxxxxxx
